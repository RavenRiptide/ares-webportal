{{! Emblem of Ea: player count and death consent rows for the event page's details table. }}
<tr>
  <td>
    <b>Players:</b>
  </td>
  <td>
    {{@event.players_summary}}
  </td>
</tr>

{{#if @event.death_consent}}
<tr>
  <td>
    <b>Death Consent:</b>
  </td>
  <td>
    <span class="badge rounded-pill bg-danger">DEATH CONSENT</span>
  </td>
</tr>
{{/if}}

{{page-title 'Events'}}
<h1>Events</h1>

<p>The events calendar helps you schedule scenes with other players.  Events you've signed up for are indicated with a <i class="fas fa-calendar-check" aria-label="Signed Up"></i> icon, and events you're on the waitlist for with a <i class="fas fa-hourglass-half" aria-label="On the Waitlist"></i> icon.</p>

<div class="action-buttons">
  {{#if this.isApproved}}
      <LinkTo @route="event-create" class="btn btn-primary">Create Event</LinkTo>
  {{/if}}
</div>

<table class="table">

<thead>
      <th></th>
      <th>Title</th>
      <th>Organizer</th>
      <th>Date/Time</th>
      <th>Players</th> {{! Emblem of Ea: Custom Ares change (eaevents) }}
      <th>Tags</th>
</thead>
       
<tbody> 
  {{#each this.model.events as |event|}}
  <tr>
    <td>
      {{! Emblem of Ea: Custom Ares change: waitlist icon (eaevents) }}
      {{#if event.is_waitlisted}}
      <i class="fas fa-hourglass-half fa-2x" aria-label="On the Waitlist"></i>
      {{else if event.is_signed_up}}
      <i class="fas fa-calendar-check fa-2x" aria-label="Signed Up"></i>
      {{/if}}
    </td>
      <td>
          <LinkTo @route="event" @model={{event.id}}>{{event.title}}</LinkTo>
          {{#if event.content_warning}}
          <ContentWarningTag @warning={{event.content_warning}} @position="top-right" />
          {{/if}}
          {{#if event.death_consent}} {{! Emblem of Ea: Custom Ares change (eaevents) }}
          <span class="badge rounded-pill bg-danger">DEATH CONSENT</span>
          {{/if}}
          {{#if event.level_range}} {{! Emblem of Ea: Custom Ares change: level range (eaevents) }}
          <span class="badge rounded-pill bg-info-subtle text-info-emphasis">{{event.level_range}}</span>
          {{/if}}
      </td>
    
      <td>
          <CharIconTiny @char={{event.organizer}} />
      </td>
      <td>
          {{event.start_datetime_local}}
          <br>({{event.start_time_standard}})
      </td>
      <td> {{! Emblem of Ea: Custom Ares change: Players column (eaevents) }}
          {{event.players}}
          {{#if event.players_note}}<br><span class="text-muted">{{event.players_note}}</span>{{/if}}
      </td>
      <td>
        {{#each event.tags as |tag|}}
        <LinkTo @route="wiki-tag" @model={{tag}}>{{tag}}</LinkTo>
        {{/each}}
      </td>
    
  </tr>

  {{/each}}
</tbody>
</table>

<div class="alert alert-info">If you're using an iCalendar-compatible calendar app like Outlook or Apple iCal, you can add the game's iCal feed to your app and it will automatically load events into your calendar: <a href="{{this.calendarUrl}}">{{this.calendarUrl}}</a>.</div>



{{outlet}}
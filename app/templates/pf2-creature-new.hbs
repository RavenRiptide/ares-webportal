{{page-title "New creature"}}
<h1>New creature</h1>

{{#if this.start}}
  <Pf2CreatureEditor @options={{this.model.options}} @start={{this.start}} />
{{else}}
  <p>Three ways to begin. Each opens the editor with something to change.</p>

  <div class="card mb-3">
    <div class="card-body">
      <h2 class="h5">From a creature that exists</h2>
      <p>The quickest way: take something close and change it.</p>
      <form class="row g-2 align-items-end" {{on "submit" this.look}}>
        <div class="col-sm-8">
          <label class="form-label" for="pf2-new-search">Name contains</label>
          <input id="pf2-new-search" type="text" class="form-control" value={{this.search}} {{on "input" (fn this.typed "search")}}>
        </div>
        <div class="col-auto"><button type="submit" class="btn btn-secondary">Look</button></div>
      </form>
      {{#each this.found as |one|}}
        <div class="mt-2">
          <button type="button" class="btn btn-primary btn-sm" {{on "click" (fn this.begin one.ref)}}>Use this</button>
          {{one.name}} &middot; level {{one.level}} &middot; {{if (eq one.source "bestiary") "bestiary" one.owner}}
        </div>
      {{/each}}
    </div>
  </div>

  <div class="card mb-3">
    <div class="card-body">
      <h2 class="h5">From a description</h2>
      <p>The line you would type after <code>+e/add Name=</code>.</p>
      <textarea class="form-control mb-2" rows="3" aria-label="Description" {{on "input" (fn this.typed "described")}}>{{this.described}}</textarea>
      <button type="button" class="btn btn-secondary" {{on "click" (fn this.begin "described" null this.described)}}>Read it</button>
    </div>
  </div>

  <div class="card mb-3">
    <div class="card-body">
      <h2 class="h5">Blank</h2>
      <div class="row g-2 align-items-end">
        <div class="col-sm-3">
          <label class="form-label" for="pf2-new-level">Level</label>
          <input id="pf2-new-level" type="text" inputmode="numeric" class="form-control" value={{this.blankLevel}} {{on "input" (fn this.typed "blankLevel")}}>
        </div>
        <div class="col-auto"><button type="button" class="btn btn-secondary" {{on "click" (fn this.begin "blank" this.blankLevel)}}>Begin</button></div>
      </div>
    </div>
  </div>
{{/if}}

<p><LinkTo @route="pf2-creatures">All creatures</LinkTo></p>

{{page-title "Creatures awaiting approval"}}
<h1>Creatures Awaiting Approval</h1>

<p><strong>Approving a creature publishes the submitted revision.</strong> Depending on the author's submitted settings, either everyone can add it to an encounter, or only the author and the people they share it with can add it to an encounter. <strong>To send a creature back for changes,</strong> include a reason with your request. The author will see it.</p>

{{#each this.model.submissions as |one|}}
  <div class="card mb-3">
    <div class="card-body">
      <h2 class="h5"><LinkTo @route="pf2-creature" @model={{one.creature.ref}}>{{one.creature.name}}</LinkTo>, level {{one.creature.level}}, by {{one.creature.owner}}</h2>
      <p>Revision {{one.revision}}{{#if one.note}}: "{{one.note}}"{{/if}}</p>
      <p><b>Requested for:</b> {{if (eq one.approved_for "author") "Author's plots only" "Everyone"}}</p>
      <p><b>What changed since it was last published:</b> {{one.changes}}</p>

      {{#if one.errors.length}}
        <div class="alert alert-danger">{{#each one.errors as |found|}}<div>{{found.message}}</div>{{/each}}</div>
      {{/if}}
      {{#if one.warnings.length}}
        <div class="alert alert-warning">{{#each one.warnings as |found|}}<div>{{found.message}}</div>{{/each}}</div>
      {{/if}}

      <div class="row">
        <div class="col-lg-7">
          {{#each one.lines as |line|}}<div class="pre-wrap">{{line}}</div>{{/each}}
        </div>
        <div class="col-lg-5 small">
          {{#each one.mechanised as |runs|}}<div><b>{{runs.part}}</b>: {{runs.says}}</div>{{/each}}
          <div class="mt-2"><b>Compared to GM Core for its level:</b> {{#each one.bands as |band|}}{{band.figure}} {{band.value}} {{band.band}}; {{/each}}</div>
        </div>
      </div>

      <label class="form-label mt-3" for="pf2-q-note-{{one.creature.id}}">A note to its author</label>
      <input id="pf2-q-note-{{one.creature.id}}" type="text" class="form-control mb-2" {{on "input" (fn this.typed one.creature.id)}}>
      <button type="button" class="btn btn-primary btn-sm" {{on "click" (fn this.decide one.creature.id "approve")}}>Approve revision {{one.revision}}</button>
      <button type="button" class="btn btn-danger btn-sm" {{on "click" (fn this.decide one.creature.id "reject")}}>Send back for changes</button>
    </div>
  </div>
{{else}}
  <p>No creatures are waiting for approval.</p>
{{/each}}

<p><LinkTo @route="pf2-creatures">All creatures</LinkTo></p>

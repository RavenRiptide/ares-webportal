{{page-title this.model.creature.name}}
<h1>{{this.model.creature.name}}</h1>

{{#if (eq this.model.creature.source "saved")}}
  <p>
    <code>c:{{this.model.creature.id}}</code> &middot; by {{this.model.creature.owner}} &middot; {{this.model.creature.status}}{{#if this.ownApproved}} for its author's plots{{/if}}
    &middot; revision {{this.model.creature.revision}}{{#if this.model.creature.can.edit}} of {{this.model.creature.latest}}{{/if}}
    {{#if this.model.creature.published_revision}} &middot; approved: revision {{this.model.creature.published_revision}}{{/if}}
  </p>
{{else}}
  <p>From the creature library.</p>
{{/if}}

{{#if this.model.addable}}
  <p>To add this creature to an encounter you're running, enter <code>{{this.model.add}}</code></p>
{{else if (eq this.model.creature.source "bestiary")}}
  <p class="alert alert-info">You may only add creatures from Monster Core and Monster Core 2. To use this creature, make your own copy: <code>creature/clone {{this.model.creature.name}}=&lt;new name&gt;</code>.</p>
{{else if (eq this.model.creature.status "draft")}}
  <p class="alert alert-info">Not yet approved. Once staff approves it, anyone may add this creature to an encounter.</p>
{{/if}}

{{#if this.model.review_note}}
  <p class="alert alert-warning"><b>Sent back:</b> {{this.model.review_note}}</p>
{{/if}}

<div class="card mb-3">
  <div class="card-body">
    {{#each this.model.lines as |line|}}
      <div class="pre-wrap">{{line}}</div>
    {{/each}}
  </div>
</div>

{{#if this.creature.can.submit}}
  <div class="card mb-3">
    <div class="card-body">
      <h2 class="h5">Approval</h2>
      {{#if this.submitted}}
        <p>Awaiting staff approval.</p>
        <button type="button" class="btn btn-secondary btn-sm" {{on "click" this.withdraw}}>Withdraw approval request</button>
      {{else if this.retired}}
        <p>Retired: This creature is hidden from lists and cannot be added to encounters.</p>
      {{else}}
        {{#if this.creature.can.make_public}}
          <p>Approved for your plots only. You (and anyone you share it with) can add this creature to encounters, and no one else can see it. Making it public lets anyone add the approved version to an encounter, with no second review.</p>
          <button type="button" class="btn btn-secondary btn-sm mb-3" {{on "click" this.makePublic}}>Make it public</button>
        {{/if}}
        {{#if this.nothingNew}}
          <p>Your latest revision is approved. If you make any further changes, you will need to submit this creature for approval again.</p>
        {{else}}
        <p>Staff will review the revision you submit. After this creature is approved, if you make any further changes, you will need to submit this creature for approval again.</p>
        <fieldset class="mb-2">
          <legend class="form-label fs-6">Approved for</legend>
          <div class="form-check">
            <input id="pf2-cr-for-everyone" type="radio" name="pf2-cr-for" class="form-check-input" checked={{eq this.approvedFor "everyone"}} {{on "change" (fn this.choose "everyone")}}>
            <label class="form-check-label" for="pf2-cr-for-everyone">Everyone</label>
          </div>
          <div class="form-check">
            <input id="pf2-cr-for-author" type="radio" name="pf2-cr-for" class="form-check-input" checked={{eq this.approvedFor "author"}} {{on "change" (fn this.choose "author")}}>
            <label class="form-check-label" for="pf2-cr-for-author">My plots only (me and people I share it with)</label>
          </div>
        </fieldset>
        <label class="form-label" for="pf2-cr-note">Note to staff (optional)</label>
        <input id="pf2-cr-note" type="text" class="form-control mb-2" value={{this.note}} {{on "input" (fn this.typed "note")}}>
        <button type="button" class="btn btn-primary btn-sm" {{on "click" this.submit}}>Submit for approval</button>
        {{/if}}
      {{/if}}
    </div>
  </div>
{{/if}}

{{#if this.creature.can.share}}
  <div class="card mb-3">
    <div class="card-body">
      <h2 class="h5">Sharing</h2>
      <form aria-label="Share" {{on "submit" this.share}}>
        {{#if this.ownApproved}}
          <p>People you list here, such as your plots' co-GMs, can add the approved version to their encounters.</p>
        {{else}}
          <p>Plotmasters and staff you share this creature with can add the current version without waiting for approval.</p>
          <div class="form-check mb-2">
            <input id="pf2-cr-pms" type="checkbox" class="form-check-input" checked={{this.sharedWithPlotmasters}} {{on "change" this.toggle}}>
            <label class="form-check-label" for="pf2-cr-pms">Every Plotmaster</label>
          </div>
        {{/if}}
        <label class="form-label" for="pf2-cr-with">Share with these people (names separated by commas)</label>
        <input id="pf2-cr-with" type="text" class="form-control mb-2" value={{this.shareText}} {{on "input" (fn this.typed "shareNames")}}>
        <button type="submit" class="btn btn-secondary btn-sm">Share</button>
      </form>
    </div>
  </div>
{{/if}}

{{#if this.creature.can.purge}}
  <div class="card mb-3">
    <div class="card-body">
      <h2 class="h5">For staff</h2>
      <form class="mb-3" aria-label="Transfer ownership to" {{on "submit" this.hand}}>
        <label class="form-label" for="pf2-cr-to">Transfer ownership to</label>
        <input id="pf2-cr-to" type="text" class="form-control mb-2" value={{this.handTo}} {{on "input" (fn this.typed "handTo")}}>
        <button type="submit" class="btn btn-secondary btn-sm">Transfer</button>
      </form>
      <p>Purging permanently deletes this creature, with all its revisions and history. You can't purge a creature that's in an encounter.</p>
      <button type="button" class="btn btn-danger btn-sm" {{on "click" this.purge}}>Purge {{this.creature.name}}</button>
    </div>
  </div>
{{/if}}

{{#if this.model.notes}}
  <h2>Notes</h2>
  <p class="pre-wrap">{{this.model.notes}}</p>
{{/if}}

{{#if this.model.history.length}}
  <h2>History</h2>
  <ol class="small">
    {{#each this.model.history as |one|}}
      <li>{{one.at}} &middot; {{one.by}} &middot; {{one.kind}}{{#if one.revision}} revision {{one.revision}}{{/if}}{{#if one.summary}}: {{one.summary}}{{/if}}</li>
    {{/each}}
  </ol>
{{/if}}

<p>
  {{#if this.model.creature.can.edit}}<LinkTo @route="pf2-creature-edit" @model={{this.model.creature.ref}} class="btn btn-primary btn-sm">Edit</LinkTo>{{/if}}
  {{#if this.model.creature.can.retire}}<button type="button" class="btn btn-secondary btn-sm" {{on "click" this.retire}}>{{if this.retired "Restore" "Retire"}}</button>{{/if}}
  {{#if this.model.creature.can.clone}}<LinkTo @route="pf2-creature-new" @query={{hash from=this.model.creature.ref}} class="btn btn-secondary btn-sm">Copy and edit</LinkTo>{{/if}}
  <LinkTo @route="pf2-creatures">All creatures</LinkTo>
</p>

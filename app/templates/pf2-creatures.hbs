{{page-title "Creatures"}}
<h1>Creatures</h1>

<p>Browse your creatures, creatures shared with you, published creatures, and the bestiary. To add one to an encounter, enter <code>encounter/add &lt;name&gt;</code>. For commands to save and edit creatures, see <code>help creatures</code>.</p>

<p>
  {{#if this.model.can_create}}<LinkTo @route="pf2-creature-new" class="btn btn-primary">New creature</LinkTo>{{/if}}
  {{#if this.model.admin}}<LinkTo @route="pf2-creature-queue" class="btn btn-secondary">Awaiting approval ({{this.model.waiting}})</LinkTo>{{/if}}
</p>

<ul class="nav nav-tabs mb-3">
  {{#each this.model.scopes as |scope|}}
    <li class="nav-item">
      <LinkTo @route="pf2-creatures" @query={{hash scope=scope page=1}} class={{if (eq scope this.model.scope) "nav-link active" "nav-link"}}>{{get this.scopeNames scope}}</LinkTo>
    </li>
  {{/each}}
</ul>

<form class="row g-2 align-items-end mb-3" {{on "submit" this.search}}>
  <div class="col-sm-5">
    <label class="form-label" for="pf2-creature-words">Name contains</label>
    <input id="pf2-creature-words" type="text" class="form-control" value={{this.words}} {{on "input" (fn this.typed "typedWords")}}>
  </div>
  <div class="col-auto">
    <label class="form-label" for="pf2-creature-from">Level from</label>
    <input id="pf2-creature-from" type="text" inputmode="numeric" class="form-control" value={{this.level_from}} {{on "input" (fn this.typed "typedFrom")}}>
  </div>
  <div class="col-auto">
    <label class="form-label" for="pf2-creature-to">to</label>
    <input id="pf2-creature-to" type="text" inputmode="numeric" class="form-control" value={{this.level_to}} {{on "input" (fn this.typed "typedTo")}}>
  </div>
  <div class="col-auto">
    <button type="submit" class="btn btn-primary">Search</button>
  </div>
</form>

{{#if this.onBestiary}}
  {{#unless this.model.runs_own}}
    <p class="alert alert-info">You may only add creatures from Monster Core and Monster Core 2. To use another bestiary creature, make your own copy with <code>creature/clone &lt;creature&gt;=&lt;new name&gt;</code> and submit it for approval. Once staff approves it, anyone may add it to an encounter.</p>
  {{/unless}}
{{/if}}

{{#if this.model.creatures.length}}
  <div class="table-responsive">
<table class="table table-striped">
    <thead>
      <tr>
        <th>Name</th>
        <th>Level</th>
        <th>Traits</th>
        {{#if this.onBestiary}}
          <th>Can add</th>
        {{else}}
          <th>Author</th>
          <th>Status</th>
        {{/if}}
      </tr>
    </thead>
    <tbody>
      {{#each this.model.creatures as |one|}}
        <tr>
          <td><LinkTo @route="pf2-creature" @model={{one.ref}}>{{one.name}}</LinkTo></td>
          <td>{{one.level}}</td>
          <td>{{pf2-join one.traits ", "}}</td>
          {{#if this.onBestiary}}
            <td>{{if one.addable "Yes" "No (copy only)"}}</td>
          {{else}}
            <td>{{one.owner}}</td>
            <td>{{one.status}}{{#if one.mine}}{{#unless (eq one.audience "private")}} &middot; shared{{/unless}}{{/if}}</td>
          {{/if}}
        </tr>
      {{/each}}
    </tbody>
  </table>
</div>

  <p>
    {{this.model.total}} total.
    {{#if this.hasPrevious}}<button type="button" class="btn btn-secondary btn-sm" {{on "click" (fn this.turn -1)}}>Previous</button>{{/if}}
    Page {{this.model.page}} of {{this.model.pages}}
    {{#if this.hasNext}}<button type="button" class="btn btn-secondary btn-sm" {{on "click" (fn this.turn 1)}}>Next</button>{{/if}}
  </p>
{{else}}
  <p>No creatures found.{{#if this.model.can_create}}Save one with <code>creature/save &lt;name&gt;=&lt;description&gt;</code>.{{/if}}</p>
{{/if}}
